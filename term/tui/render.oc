package tui;

import "os";
import "term";
import "io";

// Terminal column approximation for common combining and East Asian scalars.
// Grapheme clustering and emoji ZWJ composition are not implemented.
func columns(scalar int) int {
    if ((scalar >= 768 && scalar <= 879) || (scalar >= 6832 && scalar <= 6911) ||
        (scalar >= 7616 && scalar <= 7679) || (scalar >= 65024 && scalar <= 65039) ||
        (scalar >= 65056 && scalar <= 65071) || scalar == 8205) return 0;
    if ((scalar >= 4352 && scalar <= 4447) || scalar == 9001 || scalar == 9002 ||
        (scalar >= 11904 && scalar <= 42191) || (scalar >= 44032 && scalar <= 55203) ||
        (scalar >= 63744 && scalar <= 64255) || (scalar >= 65040 && scalar <= 65049) ||
        (scalar >= 65072 && scalar <= 65135) || (scalar >= 65281 && scalar <= 65376) ||
        (scalar >= 65504 && scalar <= 65510) || (scalar >= 127744 && scalar <= 129791) ||
        (scalar >= 131072 && scalar <= 262141)) return 2;
    return 1;
}
// A tab can expand to at most eight spaces; reserve once for the worst case.
// Write through the buffer to avoid copying owned storage on every append.
func frame(view string, size term.Size) (string, int) {
    storage := i8[len(view)*8+4];
    result := storage.data;
    used := 0;
    bytes := view -> i8[];
    source := bytes.data;
    row := 0;
    column := 0;
    clipped := false;
    // Leave the last column free to avoid autowrap and cursor accounting drift.
    width := size.Width > 1 ? size.Width - 1 : 0;
    height := size.Height > 0 ? size.Height : 1;
    for (i := 0; i < len(view);) {
        byte := (source[i] -> u8) -> int;
        if (byte == 10) {
            if (row + 1 >= height) break;
            result[used] = 13; result[used+1] = 10; used += 2; row++; column = 0; clipped = false; i++; continue;
        }
        if (byte == 27) {
            // View permits SGR colors/styles; ignore terminal control sequences.
            end := i + 1;
            if (end < len(view) && source[end] == 91) {
                end++;
                for (; end < len(view) && end - i < 64 && source[end] >= 32 && source[end] <= 63; end++) {}
                if (end < len(view) && source[end] >= 64 && source[end] <= 126) {
                    if (source[end] == 109) for (j := i; j <= end; j++) { result[used] = source[j]; used++; }
                    i = end + 1; continue;
                }
            }
            i++; continue;
        }
        if (byte == 9) {
            spaces := 8 - column % 8;
            for (j := 0; j < spaces && column < width && !clipped; j++) { result[used] = 32; used++; column++; }
            i++; continue;
        }
        if (byte < 32 || byte == 127) { i++; continue; }
        length := byte < 128 ? 1 : (byte < 224 ? 2 : (byte < 240 ? 3 : 4));
        if (i + length > len(view)) break;
        scalar := byte < 128 ? byte : (byte & (length == 2 ? 31 : (length == 3 ? 15 : 7)));
        for (j := 1; j < length; j++) scalar = scalar * 64 + ((source[i + j] -> u8) -> int & 63);
        count := columns(scalar);
        if (column + count > width) clipped = true;
        if (!clipped) {
            for (j := 0; j < length; j++) { result[used] = source[i+j]; used++; }
            column += count;
        }
        i += length;
    }
    result[used] = 27; result[used+1] = 91; result[used+2] = 48; result[used+3] = 109; used += 4;
    return storage[:used] -> string, row;
}
// Make each row self-contained, retaining inherited SGR styles across newlines.
// Comparing plain row bytes alone would miss a color changed on an earlier row.
func styledLines(text string) string[] {
    result := string[]{};
    storage := text -> i8[]; source := storage.data;
    active := ""; initial := ""; start := 0;
    for (i := 0; i < len(text);) {
        if (source[i] == 27 && i+1 < len(text) && source[i+1] == 91) {
            end := i+2;
            for (; end < len(text) && source[end] != 109; end++) {}
            if (end < len(text)) {
                sequence := text[i:end+1];
                if (sequence == "\x1b[0m" || sequence == "\x1b[m") active = "";
                else active += sequence;
                i = end+1; continue;
            }
        }
        if (source[i] == 10) {
            end := i > start && source[i-1] == 13 ? i-1 : i;
            result.append("\x1b[0m"+initial+text[start:end]+"\x1b[0m");
            start = i+1; initial = active;
        }
        i++;
    }
    result.append("\x1b[0m"+initial+text[start:]+"\x1b[0m");
    return result;
}

// Build a single synchronized write. Paint before erasing trailing content;
// never blank the viewport before drawing its replacement.
func paint(view string, previousView string, previousRows int, alternate bool, size term.Size, force bool) (string, int) {
    text, rows := frame(view,size);
    if (!alternate) {
        prefix := "\r";
        for (i := 0; i < previousRows; i++) prefix += "\x1b[1A";
        return "\x1b[?2026h"+prefix+"\x1b[0m"+text+"\x1b[0m\x1b[J\x1b[?2026l", rows;
    }
    next := styledLines(text);
    previous := string[]{};
    if (!force) {
        old, ignored := frame(previousView,size);
        previous = styledLines(old);
    }
    payload := "";
    for (i := 0; i < len(next); i++) {
        if (!force && i < len(previous) && next[i] == previous[i]) continue;
        payload += "\x1b["+io.Sprint(i+1)+";1H"+next[i]+"\x1b[0m\x1b[K";
    }
    // Shrinking views and resizes must erase rows which no longer belong to it.
    limit := force ? size.Height : previousRows+1;
    for (i := len(next); i < limit && i < size.Height; i++) payload += "\x1b["+io.Sprint(i+1)+";1H\x1b[0m\x1b[K";
    if (payload == "") return "",rows;
    return "\x1b[?2026h"+payload+"\x1b[?2026l",rows;
}
func render(output os.File, view string, previousView string, previousRows int, alternate bool, size term.Size, force bool) Result<int> {
    text, rows := paint(view,previousView,previousRows,alternate,size,force);
    if (text != "") {
        written := output.Write(text);
        if (written == Result<int>.error) return Result<int>.error(written.(Result<int>.error));
    }
    return Result<int>.value(rows);
}

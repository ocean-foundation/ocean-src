package path;

import "os";
import "testing";

struct pair { input, want string; }

func TestCleanPOSIX(t *testing.T) {
    cases := []pair{
        {"", "."}, {".", "."}, {"a/b/", "a/b"}, {"a//b", "a/b"}, {"./a/./b", "a/b"},
        {"a/../b", "b"}, {"../a", "../a"}, {"a/../..", ".."}, {"/../a", "/a"}, {"/", "/"},
        {"//a", "/a"}, {"a\\b", "a\\b"},
    };
    for (_, c := range cases) {
        if (clean(c.input, false) != c.want) t.Errorf("clean({}) = {}, want {}", c.input, clean(c.input, false), c.want);
    }
}

func TestCleanWindows(t *testing.T) {
    cases := []pair{
        {"C:\\a\\..\\b", "C:/b"}, {"c:/", "c:/"}, {"C:", "C:"}, {"C:a/../..", "C:.."},
        {"\\\\server\\share\\x\\..", "//server/share/"}, {"a\\b\\", "a/b"},
    };
    for (_, c := range cases) {
        if (clean(c.input, true) != c.want) t.Errorf("clean({}) = {}, want {}", c.input, clean(c.input, true), c.want);
    }
    if (!isAbs("C:\\x", true) || isAbs("C:x", true) || isAbs("/x", true) || !isAbs("//srv/share", true)) t.Error("isAbs windows");
    if (!isAbs("/x", false) || isAbs("x", false) || isAbs("C:/x", false)) t.Error("isAbs posix");
}

func TestElements(t *testing.T) {
    if (Join("a", "b", "../c") != "a/c" || Join("", "") != "" || Join("/", "x") != "/x" || Join("a", "", "b") != "a/b") t.Error("Join");
    if (base("a/b/", false) != "b" || base("", false) != "." || base("/", false) != "/" || base("file.oc", false) != "file.oc") t.Error("base");
    if (base("C:\\dir\\f.txt", true) != "f.txt") t.Error("base windows");
    if (dir("a/b", false) != "a" || dir("a", false) != "." || dir("/a", false) != "/" || dir("/", false) != "/") t.Error("dir");
    if (dir("C:\\a\\b", true) != "C:/a" || dir("C:\\a", true) != "C:/") t.Error("dir windows");
    if (ext("a/b.tar.gz", false) != ".gz" || ext("a.d/b", false) != "" || ext("x.", false) != ".") t.Error("ext");
    d, f := Split("a/b/c.oc");
    if (d != "a/b/" || f != "c.oc") t.Error("Split");
    d, f = Split("plain");
    if (d != "" || f != "plain") t.Error("Split plain");
}

func TestRel(t *testing.T) {
    if (rel("/a/b", "/a/b/c/d", false).unwrap() != "c/d") t.Error("rel down");
    if (rel("/a/b/c", "/a/x", false).unwrap() != "../../x") t.Error("rel up");
    if (rel("a", "a", false).unwrap() != ".") t.Error("rel same");
    if (rel("a/b", "c", false).unwrap() != "../../c") t.Error("rel relative");
    if (!rel("/a", "b", false).hasError()) t.Error("rel mixed");
    if (!rel("../a", "b", false).hasError()) t.Error("rel unknowable");
    if (rel("C:\\Users\\Me", "c:/users/me/docs", true).unwrap() != "docs") t.Error("rel windows case");
    if (!rel("C:/a", "D:/a", true).hasError()) t.Error("rel windows volumes");
}

func TestAbs(t *testing.T) {
    cwd := os.Getwd().unwrap();
    if (Abs("x/../y").unwrap() != Join(cwd, "y")) t.Error("Abs relative");
    if (!onWindows() && Abs("/a/./b").unwrap() != "/a/b") t.Error("Abs absolute");
    if (!IsAbs(Abs("z").unwrap())) t.Error("Abs result");
}

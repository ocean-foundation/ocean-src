package sort_test;

import "sort";
import "strconv";
import "testing";

struct person { name string; age int; }

func TestBuiltinTypes(t *testing.T) {
    ints := []int{5, -1, 3, 3, 0, 9, -7, 2, 8, 1, 4, 6, 10, -3, 7};
    sort.Ints(&ints);
    for (i := 1; i < len(ints); i++) { if (ints[i - 1] > ints[i]) t.Fatalf("Ints not sorted at {}", i); }
    floats := []float{2.5, -1.0, 0.0, 3.25};
    sort.Floats(&floats);
    if (floats[0] != -1.0 || floats[3] != 3.25) t.Error("Floats");
    words := []string{"pear", "Apple", "banana", "apple", ""};
    sort.Strings(&words);
    expected := []string{"", "Apple", "apple", "banana", "pear"};
    for (i := 0; i < len(words); i++) { if (words[i] != expected[i]) t.Errorf("Strings[{}] = {}", i, words[i]); }
    empty := []int{};
    sort.Ints(&empty);
    if (len(empty) != 0) t.Error("empty");
}

func TestLargeAndStable(t *testing.T) {
    // A deterministic pseudo-random sequence long enough to exercise merging.
    people := []person{};
    seed := 12345;
    for (i := 0; i < 1000; i++) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        people.append(person{"p" + strconv.Itoa(i), seed % 20});
    }
    sort.Slice<person>(&people, func(a person, b person) bool { return a.age < b.age; });
    for (i := 1; i < len(people); i++) {
        if (people[i - 1].age > people[i].age) t.Fatalf("not sorted at {}", i);
        if (people[i - 1].age == people[i].age && order(people[i - 1].name) > order(people[i].name)) t.Fatalf("not stable at {}", i);
    }
    if (!sort.IsSorted<person>(people, func(a person, b person) bool { return a.age < b.age; })) t.Error("IsSorted");
    if (sort.IsSorted<int>([]int{1, 3, 2}, func(a int, b int) bool { return a < b; })) t.Error("IsSorted unsorted");
}

func order(name string) int {
    n := 0;
    for (i := 1; i < len(name); i++) n = n * 10 + (name[i] - '0') -> int;
    return n;
}

func TestSearchAndReverse(t *testing.T) {
    items := []int{1, 3, 5, 7};
    if (sort.SearchInts(items, 5) != 2 || sort.SearchInts(items, 4) != 2 || sort.SearchInts(items, 0) != 0 || sort.SearchInts(items, 9) != 4) t.Error("SearchInts");
    if (sort.SearchStrings([]string{"a", "c"}, "b") != 1) t.Error("SearchStrings");
    if (sort.Search(100, func(i int) bool { return i * i >= 50; }) != 8) t.Error("Search");
    sort.Reverse<int>(&items);
    if (items[0] != 7 || items[3] != 1) t.Error("Reverse");
}

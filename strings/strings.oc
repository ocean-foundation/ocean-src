package strings;

// Byte-oriented string helpers. Ocean strings are immutable byte sequences,
// usually UTF-8; every index here is a byte offset. Case helpers are ASCII-only.
// Ocean copies string arguments, so loops here pass *string to helpers.

// Contains reports whether needle occurs in text.
func Contains(text string, needle string) bool { return Index(text, needle) >= 0; }

// ContainsByte reports whether the byte c occurs in text.
func ContainsByte(text string, c i8) bool { return IndexByte(text, c) >= 0; }

// ContainsAny reports whether any byte of chars occurs in text.
func ContainsAny(text string, chars string) bool { return IndexAny(text, chars) >= 0; }

// HasPrefix reports whether text begins with prefix.
func HasPrefix(text string, prefix string) bool {
    if (len(prefix) > len(text)) return false;
    for (i := 0; i < len(prefix); i++) { if (text[i] != prefix[i]) return false; }
    return true;
}

// HasSuffix reports whether text ends with suffix.
func HasSuffix(text string, suffix string) bool {
    if (len(suffix) > len(text)) return false;
    offset := len(text) - len(suffix);
    for (i := 0; i < len(suffix); i++) { if (text[offset + i] != suffix[i]) return false; }
    return true;
}

func matchesAt(text *string, needle *string, at int) bool {
    for (j := 0; j < len(*needle); j++) { if ((*text)[at + j] != (*needle)[j]) return false; }
    return true;
}

func hasByte(set *string, c i8) bool {
    for (i := 0; i < len(*set); i++) { if ((*set)[i] == c) return true; }
    return false;
}

// Index returns the byte offset of the first needle in text, or -1.
// An empty needle matches at 0.
func Index(text string, needle string) int {
    if (len(needle) == 0) return 0;
    first := needle[0];
    for (i := 0; i + len(needle) <= len(text); i++) {
        if (text[i] == first && matchesAt(&text, &needle, i)) return i;
    }
    return -1;
}

// LastIndex returns the byte offset of the last needle in text, or -1.
// An empty needle matches at len(text).
func LastIndex(text string, needle string) int {
    if (len(needle) == 0) return len(text);
    for (i := len(text) - len(needle); i >= 0; i--) {
        if (matchesAt(&text, &needle, i)) return i;
    }
    return -1;
}

// IndexByte returns the offset of the first byte c in text, or -1.
func IndexByte(text string, c i8) int {
    for (i := 0; i < len(text); i++) { if (text[i] == c) return i; }
    return -1;
}

// LastIndexByte returns the offset of the last byte c in text, or -1.
func LastIndexByte(text string, c i8) int {
    for (i := len(text) - 1; i >= 0; i--) { if (text[i] == c) return i; }
    return -1;
}

// IndexAny returns the offset of the first byte in text that occurs in chars, or -1.
func IndexAny(text string, chars string) int {
    for (i := 0; i < len(text); i++) { if (hasByte(&chars, text[i])) return i; }
    return -1;
}

// Count returns the number of non-overlapping needles in text. An empty
// needle counts every position between bytes: len(text) + 1.
func Count(text string, needle string) int {
    if (len(needle) == 0) return len(text) + 1;
    count := 0;
    for (i := 0; i + len(needle) <= len(text);) {
        if (matchesAt(&text, &needle, i)) { count++; i += len(needle); }
        else i++;
    }
    return count;
}

// utf8Width is the byte length of the UTF-8 sequence starting at text[i],
// or 1 for an invalid or truncated sequence.
func utf8Width(text *string, i int) int {
    first := ((*text)[i] -> u8) -> int;
    width := 1;
    if (first >= 194 && first < 224) width = 2;
    else if (first >= 224 && first < 240) width = 3;
    else if (first >= 240 && first < 245) width = 4;
    if (width > len(*text) - i) return 1;
    for (j := 1; j < width; j++) {
        b := ((*text)[i + j] -> u8) -> int;
        if (b < 128 || b > 191) return 1;
        if (j == 1 && ((first == 224 && b < 160) || (first == 237 && b > 159) ||
                       (first == 240 && b < 144) || (first == 244 && b > 143))) return 1;
    }
    return width;
}

// Split slices text into all substrings separated by sep. An empty sep splits
// after each UTF-8 character. Splitting "" gives one empty string.
func Split(text string, sep string) []string { return SplitN(text, sep, -1); }

// SplitN is Split, returning at most limit substrings; the last holds the
// unsplit remainder. A negative limit means no limit and zero returns none.
func SplitN(text string, sep string, limit int) []string {
    parts := make([]string);
    if (limit == 0) return parts;
    if (text == "") return []string{""};
    if (len(sep) == 0) {
        for (i := 0; i < len(text);) {
            if (limit > 0 && len(parts) == limit - 1) { parts.append(text[i:]); return parts; }
            width := utf8Width(&text, i);
            parts.append(text[i:i + width]);
            i += width;
        }
        return parts;
    }
    start := 0;
    for (i := 0; i + len(sep) <= len(text);) {
        if (limit > 0 && len(parts) == limit - 1) break;
        if (matchesAt(&text, &sep, i)) {
            parts.append(text[start:i]);
            i += len(sep);
            start = i;
        } else i++;
    }
    parts.append(text[start:]);
    return parts;
}

// IsSpace reports whether c is an ASCII space, tab, newline, vertical tab,
// form feed, or carriage return.
func IsSpace(c i8) bool { return c == ' ' || (c >= 9 && c <= 13); }

// Fields splits text around runs of ASCII whitespace, dropping empty fields.
func Fields(text string) []string {
    fields := make([]string);
    start := -1;
    for (i := 0; i < len(text); i++) {
        if (IsSpace(text[i])) {
            if (start >= 0) { fields.append(text[start:i]); start = -1; }
        } else if (start < 0) start = i;
    }
    if (start >= 0) fields.append(text[start:]);
    return fields;
}

// Lines splits text at "\n", removing a "\r" before each newline. A final
// newline does not produce a trailing empty line.
func Lines(text string) []string {
    lines := make([]string);
    start := 0;
    for (i := 0; i < len(text); i++) {
        if (text[i] == '\n') {
            end := i;
            if (end > start && text[end - 1] == '\r') end--;
            lines.append(text[start:end]);
            start = i + 1;
        }
    }
    if (start < len(text)) lines.append(text[start:]);
    return lines;
}

// Cut splits text around the first sep, reporting whether it was found.
// When it is missing, before is text and after is empty.
func Cut(text string, sep string) (string, string, bool) {
    at := Index(text, sep);
    if (at < 0) return text, "", false;
    return text[:at], text[at + len(sep):], true;
}

// Join concatenates parts with sep between neighbors.
func Join(parts []string, sep string) string {
    builder: Builder;
    for (i := 0; i < len(parts); i++) {
        if (i > 0) builder.WriteString(sep);
        builder.WriteString(parts[i]);
    }
    return builder.String();
}

// Repeat returns count copies of text. A negative count panics.
func Repeat(text string, count int) string {
    if (count < 0) panic "strings: negative Repeat count";
    builder: Builder;
    for (i := 0; i < count; i++) builder.WriteString(text);
    return builder.String();
}

// Replace replaces the first limit non-overlapping olds with replacement,
// scanning left to right; a negative limit replaces all. An empty old
// matches before each UTF-8 character and at the end.
func Replace(text string, old string, replacement string, limit int) string {
    if (limit == 0) return text;
    builder: Builder;
    done := 0;
    i := 0;
    if (len(old) == 0) {
        for (i <= len(text)) {
            if (limit < 0 || done < limit) { builder.WriteString(replacement); done++; }
            if (i == len(text)) break;
            width := utf8Width(&text, i);
            builder.WriteString(text[i:i + width]);
            i += width;
        }
        return builder.String();
    }
    for (i < len(text)) {
        if ((limit < 0 || done < limit) && i + len(old) <= len(text) && matchesAt(&text, &old, i)) {
            builder.WriteString(replacement);
            i += len(old);
            done++;
        } else {
            builder.WriteByte(text[i]);
            i++;
        }
    }
    return builder.String();
}

// ReplaceAll replaces every non-overlapping old with replacement.
func ReplaceAll(text string, old string, replacement string) string { return Replace(text, old, replacement, -1); }

// TrimSpace removes leading and trailing ASCII whitespace.
func TrimSpace(text string) string {
    start := 0;
    end := len(text);
    for (start < end && IsSpace(text[start])) start++;
    for (end > start && IsSpace(text[end - 1])) end--;
    return text[start:end];
}

// Trim removes leading and trailing bytes contained in cutset.
func Trim(text string, cutset string) string {
    start := 0;
    end := len(text);
    for (start < end && hasByte(&cutset, text[start])) start++;
    for (end > start && hasByte(&cutset, text[end - 1])) end--;
    return text[start:end];
}

// TrimLeft removes leading bytes contained in cutset.
func TrimLeft(text string, cutset string) string {
    start := 0;
    for (start < len(text) && hasByte(&cutset, text[start])) start++;
    return text[start:];
}

// TrimRight removes trailing bytes contained in cutset.
func TrimRight(text string, cutset string) string {
    end := len(text);
    for (end > 0 && hasByte(&cutset, text[end - 1])) end--;
    return text[:end];
}

// TrimPrefix removes one leading prefix, if present.
func TrimPrefix(text string, prefix string) string {
    if (HasPrefix(text, prefix)) return text[len(prefix):];
    return text;
}

// TrimSuffix removes one trailing suffix, if present.
func TrimSuffix(text string, suffix string) string {
    if (HasSuffix(text, suffix)) return text[:len(text) - len(suffix)];
    return text;
}

// ToLower maps ASCII letters to lower case; other bytes are unchanged.
func ToLower(text string) string {
    bytes := text -> []i8;
    for (i := 0; i < len(bytes); i++) {
        if (bytes[i] >= 'A' && bytes[i] <= 'Z') bytes[i] = bytes[i] + 32;
    }
    return bytes -> string;
}

// ToUpper maps ASCII letters to upper case; other bytes are unchanged.
func ToUpper(text string) string {
    bytes := text -> []i8;
    for (i := 0; i < len(bytes); i++) {
        if (bytes[i] >= 'a' && bytes[i] <= 'z') bytes[i] = bytes[i] - 32;
    }
    return bytes -> string;
}

func lowerByte(c i8) i8 { if (c >= 'A' && c <= 'Z') return c + 32; return c; }

// EqualFold reports whether a and b are equal, ignoring ASCII case.
func EqualFold(a string, b string) bool {
    if (len(a) != len(b)) return false;
    for (i := 0; i < len(a); i++) { if (lowerByte(a[i]) != lowerByte(b[i])) return false; }
    return true;
}

// Compare returns -1, 0, or 1 by unsigned byte order, like a < b, a == b, a > b.
func Compare(a string, b string) int {
    if (a < b) return -1;
    if (a > b) return 1;
    return 0;
}

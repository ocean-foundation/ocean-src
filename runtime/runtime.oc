package runtime;

// Target identification. Values describe the target the program was compiled
// for, fixed at build time; no environment variable changes them.

// Windows reports whether the program targets Windows.
func Windows() bool { return OS() == "windows"; }

// MacOS reports whether the program targets macOS.
func MacOS() bool { return OS() == "macos"; }

// Linux reports whether the program targets Linux.
func Linux() bool { return OS() == "linux"; }

// Wasm reports whether the program targets JavaScript/WebAssembly.
func Wasm() bool { return OS() == "js"; }

// ExeSuffix is the file-name suffix of native executables: ".exe" on
// Windows, otherwise empty.
func ExeSuffix() string { return Windows() ? ".exe" : ""; }

// PathSeparator is the preferred separator for native paths: '\\' on
// Windows and '/' elsewhere. Windows also accepts '/'.
func PathSeparator() i8 { return (Windows() ? '\\' : '/') -> i8; }

// PathListSeparator separates entries of PATH-like variables: ';' on
// Windows and ':' elsewhere.
func PathListSeparator() i8 { return (Windows() ? ';' : ':') -> i8; }

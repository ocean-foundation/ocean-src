package runtime_test;

import "runtime";
import "testing";

func TestHost(t *testing.T) {
    os := runtime.OS();
    if (os != "linux" && os != "macos" && os != "windows") t.Errorf("unexpected OS {}", os);
    arch := runtime.Arch();
    if (arch != "x86_64" && arch != "aarch64" && arch != "riscv64") t.Errorf("unexpected Arch {}", arch);
    if (runtime.Windows() != (os == "windows") || runtime.MacOS() != (os == "macos") || runtime.Linux() != (os == "linux") || runtime.Wasm()) t.Error("predicates");
    if ((runtime.ExeSuffix() == ".exe") != runtime.Windows()) t.Error("ExeSuffix");
    if ((runtime.PathSeparator() == '\\') != runtime.Windows() || (runtime.PathListSeparator() == ';') != runtime.Windows()) t.Error("separators");
}

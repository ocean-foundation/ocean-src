package strconv_test;

import "strconv";
import "testing";

func TestFormat(t *testing.T) {
    if (strconv.Itoa(0) != "0" || strconv.Itoa(-42) != "-42" || strconv.Itoa(1234567) != "1234567") t.Error("Itoa");
    if (strconv.Itoa(-9223372036854775807 - 1) != "-9223372036854775808") t.Error("Itoa min");
    if (strconv.FormatInt(255, 16) != "ff" || strconv.FormatInt(-5, 2) != "-101" || strconv.FormatInt(35, 36) != "z") t.Error("FormatInt");
    if (strconv.FormatUint(18446744073709551615 -> uint, 16) != "ffffffffffffffff") t.Error("FormatUint max");
    if (strconv.FormatUint(0 -> uint, 2) != "0") t.Error("FormatUint zero");
    if (strconv.FormatBool(true) != "true" || strconv.FormatBool(false) != "false") t.Error("FormatBool");
}

func TestParse(t *testing.T) {
    if (strconv.Atoi("42").unwrap() != 42 || strconv.Atoi("-7").unwrap() != -7 || strconv.Atoi("+0007").unwrap() != 7) t.Error("Atoi");
    if (strconv.ParseInt("ff", 16).unwrap() != 255 || strconv.ParseInt("-FF", 16).unwrap() != -255) t.Error("ParseInt hex");
    if (strconv.ParseInt("9223372036854775807", 10).unwrap() != 9223372036854775807) t.Error("ParseInt max");
    if (strconv.ParseInt("-9223372036854775808", 10).unwrap() != -9223372036854775807 - 1) t.Error("ParseInt min");
    for (_, bad := range []string{"", "+", "-", " 1", "1 ", "12a", "9223372036854775808", "-9223372036854775809", "0x10"}) {
        if (!strconv.Atoi(bad).hasError()) t.Errorf("Atoi({}) should fail", strconv.Quote(bad));
    }
    if (!strconv.ParseInt("2", 2).hasError() || !strconv.ParseInt("1", 37).hasError()) t.Error("ParseInt digit/base checks");
    if (strconv.ParseUint("18446744073709551615", 10).unwrap() != 18446744073709551615 -> uint) t.Error("ParseUint max");
    if (!strconv.ParseUint("18446744073709551616", 10).hasError() || !strconv.ParseUint("-1", 10).hasError()) t.Error("ParseUint errors");
    if (!strconv.ParseBool("true").unwrap() || strconv.ParseBool("false").unwrap() || !strconv.ParseBool("yes").hasError()) t.Error("ParseBool");
}

func TestQuote(t *testing.T) {
    if (strconv.Quote("a\"b\\c\n\t\x01é") != "\"a\\\"b\\\\c\\n\\t\\x01é\"") t.Errorf("Quote: {}", strconv.Quote("a\"b\\c\n\t\x01é"));
    if (strconv.Quote("\x00" + "1") != "\"\\x001\"") t.Error("Quote NUL before digit");
    samples := []string{"", "plain", "quote \" and \\ slash", "lines\r\n", "\x00\x7f\x1b", "日本"};
    for (_, sample := range samples) {
        back := strconv.Unquote(strconv.Quote(sample)).unwrap();
        if (back != sample) t.Errorf("round trip of {}", strconv.Quote(sample));
    }
    if (strconv.Unquote("\"\\u00e9\\U0001F600\\101\\?\"").unwrap() != "é😀A?") t.Error("Unquote escapes");
    for (_, bad := range []string{"", "\"", "x\"\"", "\"a\"b\"", "\"\\\"", "\"\\q\"", "\"\\x4\"", "\"\\ud800\""}) {
        if (!strconv.Unquote(bad).hasError()) t.Errorf("Unquote({}) should fail", bad);
    }
}

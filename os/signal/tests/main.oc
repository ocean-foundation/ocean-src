package main;

import "io";
import "os/signal";
import "threads";
import "time";

// Blocks the termination signals, reports readiness, then collects two
// signals sent by tests/test_signal.py and prints their names.
func main() int {
    signal.Block().unwrap();
    io.Println("ready");
    for (collected := 0; collected < 2;) {
        number := signal.Wait(5000000000);
        if (number == 0) { io.Println("timeout"); return 1; }
        io.Println(signal.Name(number));
        collected++;
    }
    // A worker inherits the blocked signals. Only one collector can get SIGTERM.
    other := 0;
    worker := threads.Spawn(func() { other = signal.Wait(time.Second); });
    io.Println("concurrent ready");
    received := signal.Wait(time.Second);
    threads.Await(worker);
    if (!((received == signal.Terminate && other == 0) || (received == 0 && other == signal.Terminate))) {
        io.Println("unexpected concurrent results", received, other);
        return 1;
    }
    io.Println("concurrent wait finished");
    return 0;
}

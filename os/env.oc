package os;

import "internal/native";

// Environment variables and process identity. On Windows these use the
// Win32 environment block, which child processes inherit.

func unsupported(operation string) string { return "os: " + operation + " is unsupported on this platform"; }

func nativeError(operation string, subject string) string {
    if (nativeWasm()) return unsupported(operation);
    detail := nativeWindows() ? windowsErrorText() : native.LastError();
    if (subject == "") return "os: " + operation + ": " + detail;
    return "os: " + operation + " " + subject + ": " + detail;
}

// Win32 calls report through GetLastError; CRT calls set errno instead.
func windowsErrorText() string {
    code := native.WinGetLastError();
    if (code == 2 || code == 3) return "No such file or directory";
    if (code == 5) return "Permission denied";
    if (code == 80 || code == 183) return "File exists";
    if (code == 145) return "Directory not empty";
    if (code == 267) return "Not a directory";
    if (code == 32) return "File is in use";
    if (code == 123) return "Invalid name";
    if (code == 0) return native.LastError();
    return "Windows error " + decimal(code);
}

func decimal(n int) string {
    if (n == 0) return "0";
    negative := n < 0;
    digits := make([]i8);
    for (n != 0) {
        d := n % 10;
        if (d < 0) d = -d;
        digits.prepend(('0' + d) -> i8);
        n = n / 10;
    }
    if (negative) digits.prepend('-');
    return digits -> string;
}

func validName(name string) bool {
    if (name == "" || native.HasNUL(name)) return false;
    for (i := 0; i < len(name); i++) { if (name[i] == '=') return false; }
    return true;
}

// LookupEnv returns the value of the environment variable name and whether
// it is set. A variable can be set to the empty string.
func LookupEnv(name string) (string, bool) {
    if (!validName(name)) return "", false;
    if (nativeWindows()) {
        wide := native.Wide(name);
        if (wide.hasError()) return "", false;
        key := wide.unwrap();
        size := 1024;
        for (;;) {
            buffer := native.Zeroed(size * 2);
            native.WinSetLastError(0);
            n := native.WinGetEnvironmentVariable(native.Address(&key), native.Address(&buffer), size);
            if (n == 0) return "", native.WinGetLastError() != 203; // ERROR_ENVVAR_NOT_FOUND
            if (n < size) return native.FromWide(native.Address(&buffer), n), true;
            size = n;
        }
    }
    key := native.CString(name);
    value := native.Getenv(native.Address(&key));
    if (value == 0 || value == -1) return "", false;
    return native.FromC(value), true;
}

// Getenv returns the value of the environment variable name, or "" when it
// is not set. Use LookupEnv to tell an empty value from a missing one.
func Getenv(name string) string {
    value, _ := LookupEnv(name);
    return value;
}

// Setenv sets the environment variable name to value for this process and
// the children it starts afterwards. Names cannot be empty or contain '='.
func Setenv(name string, value string) Result<bool> {
    if (!validName(name)) return Result<bool>.error("os: invalid environment variable name");
    if (native.HasNUL(value)) return Result<bool>.error("os: environment value contains NUL");
    if (nativeWindows()) {
        key := native.Wide(name).unwrap();
        converted := native.Wide(value);
        if (converted.hasError()) return Result<bool>.error("os: environment value is not valid UTF-8");
        data := converted.unwrap();
        if (native.WinSetEnvironmentVariable(native.Address(&key), native.Address(&data)) == 0) return Result<bool>.error(nativeError("setenv", name));
        return Result<bool>.value(true);
    }
    key := native.CString(name);
    data := native.CString(value);
    if (native.Setenv(native.Address(&key), native.Address(&data), 1) != 0) return Result<bool>.error(nativeError("setenv", name));
    return Result<bool>.value(true);
}

// Unsetenv removes the environment variable name. Removing a variable that
// is not set succeeds.
func Unsetenv(name string) Result<bool> {
    if (!validName(name)) return Result<bool>.error("os: invalid environment variable name");
    if (nativeWindows()) {
        key := native.Wide(name).unwrap();
        native.WinSetLastError(0);
        if (native.WinSetEnvironmentVariable(native.Address(&key), 0) == 0 && native.WinGetLastError() != 203)
            return Result<bool>.error(nativeError("unsetenv", name));
        return Result<bool>.value(true);
    }
    key := native.CString(name);
    if (native.Unsetenv(native.Address(&key)) != 0) return Result<bool>.error(nativeError("unsetenv", name));
    return Result<bool>.value(true);
}

// Getpid returns the process ID, or -1 where processes have no ID (Wasm).
func Getpid() int {
    if (nativeWindows()) return native.WinGetCurrentProcessId();
    return native.Getpid();
}

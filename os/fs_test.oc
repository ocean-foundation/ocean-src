package os_test;

import "os";
import "os/exec";
import "testing";

func scratch(t *testing.T) string {
    dir := os.MkdirTemp("ocean-os-test-").unwrap();
    t.Cleanup(func() { os.RemoveAll(dir).unwrap(); });
    return dir;
}

func TestEnvironment(t *testing.T) {
    name := "OCEAN_OS_TEST_VARIABLE";
    os.Unsetenv(name).unwrap();
    value, ok := os.LookupEnv(name);
    if (ok || value != "") t.Error("unset variable reported as set");
    os.Setenv(name, "café").unwrap();
    if (os.Getenv(name) != "café") t.Errorf("Getenv = {}", os.Getenv(name));
    os.Setenv(name, "").unwrap();
    value, ok = os.LookupEnv(name);
    if (!ok || value != "") t.Error("empty variable should be set");
    os.Unsetenv(name).unwrap();
    if (os.Getenv(name) != "") t.Error("Unsetenv");
    if (!os.Setenv("", "x").hasError() || !os.Setenv("A=B", "x").hasError()) t.Error("invalid names");
    if (os.Getpid() <= 0) t.Error("Getpid");
}

func TestFilesAndDirectories(t *testing.T) {
    dir := scratch(t);
    if (!os.IsDir(dir)) t.Fatal("MkdirTemp did not create a directory");
    file := dir + "/notes.txt";
    if (os.WriteFile(file, "hello\nworld\n").unwrap() != 12) t.Error("WriteFile count");
    if (os.ReadFile(file).unwrap() != "hello\nworld\n") t.Error("ReadFile");
    info := os.Stat(file).unwrap();
    if (info.Name != "notes.txt" || info.Size != 12 || !info.IsRegular() || info.IsDir()) t.Errorf("Stat: {}", info);
    if (info.ModTime <= 0) t.Error("ModTime");
    if (!os.Exists(file) || os.Exists(dir + "/missing")) t.Error("Exists");

    os.MkdirAll(dir + "/a/b/c").unwrap();
    os.MkdirAll(dir + "/a/b/c").unwrap();
    if (!os.IsDir(dir + "/a/b/c")) t.Error("MkdirAll");
    if (!os.MkdirAll(file + "/sub").hasError()) t.Error("MkdirAll below a file should fail");
    made := os.Mkdir(dir + "/a");
    if (!made.hasError()) t.Error("Mkdir of an existing directory should fail");
    else if (made.error() != "os: mkdir " + dir + "/a: File exists") t.Errorf("Mkdir error: {}", made.error());

    os.WriteFile(dir + "/a/b/x.oc", "").unwrap();
    os.Rename(dir + "/a/b/x.oc", dir + "/a/y.oc").unwrap();
    names := os.ListDir(dir + "/a").unwrap();
    if (len(names) != 2 || names[0] != "b" || names[1] != "y.oc") t.Errorf("ListDir: {}", names);
    if (!os.ListDir(dir + "/missing").hasError()) t.Error("ListDir missing");

    if (!os.Remove(dir + "/a").hasError()) t.Error("Remove of a non-empty directory should fail");
    os.Remove(dir + "/a/y.oc").unwrap();
    os.Remove(dir + "/a/b/c").unwrap();
    if (os.Exists(dir + "/a/b/c")) t.Error("Remove directory");
    os.RemoveAll(dir + "/a").unwrap();
    if (os.Exists(dir + "/a")) t.Error("RemoveAll");
    os.RemoveAll(dir + "/never-existed").unwrap();
    missing := os.Stat(dir + "/never-existed");
    if (!missing.hasError() || missing.error() != "os: stat " + dir + "/never-existed: No such file or directory") t.Errorf("Stat error: {}", missing.error());
}

func TestPermissionsAndLinks(t *testing.T) {
    if (os.OS() == "windows") t.Skip("POSIX permissions and links");
    dir := scratch(t);
    file := dir + "/script";
    os.WriteFile(file, "#!/bin/sh\n").unwrap();
    os.Chmod(file, 493).unwrap(); // 0755
    if (os.Stat(file).unwrap().Perm() != 493) t.Errorf("Perm = {}", os.Stat(file).unwrap().Perm());
    if (os.Lstat(file).unwrap().IsSymlink()) t.Error("regular file reported as link");
    if (os.Stat(dir).unwrap().Perm() != 448) t.Error("MkdirTemp should be private (0700)");
    sub := dir + "/sub";
    os.Mkdir(sub).unwrap();
    os.WriteFile(sub + "/kept", "x").unwrap();
    link := exec.Command("ln", "-s", sub, dir + "/link");
    link.Run().unwrap();
    if (!os.Lstat(dir + "/link").unwrap().IsSymlink() || !os.Stat(dir + "/link").unwrap().IsDir()) t.Error("Lstat/Stat of a link");
    if (os.Realpath(dir + "/link/kept").unwrap() != os.Realpath(sub).unwrap() + "/kept") t.Error("Realpath through a link");
    // RemoveAll removes the link itself, not the directory it points to.
    os.RemoveAll(dir + "/link").unwrap();
    if (os.Lstat(dir + "/link").hasError() == false || !os.Exists(sub + "/kept")) t.Error("RemoveAll followed a link");
}

func TestWorkingDirectory(t *testing.T) {
    dir := scratch(t);
    original := os.Getwd().unwrap();
    t.Cleanup(func() { os.Chdir(original).unwrap(); });
    os.Chdir(dir).unwrap();
    if (os.Getwd().unwrap() != os.Realpath(dir).unwrap()) t.Errorf("Getwd = {}", os.Getwd().unwrap());
    os.WriteFile("relative.txt", "x").unwrap();
    if (!os.Exists(dir + "/relative.txt")) t.Error("relative path after Chdir");
    if (!os.Chdir(dir + "/missing").hasError()) t.Error("Chdir missing");
    if (os.Realpath(".").unwrap() != os.Realpath(dir).unwrap()) t.Error("Realpath .");
    if (!os.Realpath(dir + "/missing").hasError()) t.Error("Realpath missing");
}

func TestProgramAndTemporaryFiles(t *testing.T) {
    exe := os.Executable().unwrap();
    if (!os.Stat(exe).unwrap().IsRegular()) t.Errorf("Executable {} is not a file", exe);
    temp := os.TempDir();
    if (!os.IsDir(temp)) t.Errorf("TempDir {} is not a directory", temp);
    path := os.CreateTemp("ocean-os-file-").unwrap();
    t.Cleanup(func() { os.Remove(path).unwrap(); });
    if (os.Stat(path).unwrap().Size != 0) t.Error("CreateTemp should be empty");
    if (!os.CreateTemp("bad/prefix").hasError()) t.Error("CreateTemp prefix with separator");
    other := os.CreateTemp("ocean-os-file-").unwrap();
    os.Remove(other).unwrap();
    if (other == path) t.Error("CreateTemp names should be unique");
}

func TestInvalidPaths(t *testing.T) {
    if (!os.Stat("").hasError() || !os.Mkdir("a\x00b").hasError() || !os.Remove("").hasError()) t.Error("empty and NUL paths");
}

func TestPlatformHelpers(t *testing.T) {
    windows := os.OS() == "windows";
    if ((os.ExeSuffix() == ".exe") != windows) t.Error("ExeSuffix");
    if ((os.PathSeparator() == '\\') != windows || (os.PathListSeparator() == ';') != windows) t.Error("separators");
}

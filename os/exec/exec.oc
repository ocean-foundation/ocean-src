package exec;

import "sync";
import "time";

// This narrow ABI is implemented by the matching compiler's embedded native
// process runtime. The public command API and all validation remain in Ocean.
struct nativeCommand {
    path buffer<i8>;
    argv *void;
    directory buffer<i8>;
    environment *void;
    capture int;
    combined int;
    exitCode int;
    output buffer<i8>;
    outputSize int;
    error buffer<i8>;
}
extern i32 ocean_process_run(*nativeCommand command);
extern i32 ocean_process_run_input(*nativeCommand command, buffer<i8> input, int size, int hasInput);
extern i32 ocean_process_start(*nativeCommand command, buffer<i8> input, int size, int hasInput, *int handle, *int pid);
extern i32 ocean_process_wait(int handle, int block, *int exitCode, *int signal);
extern i32 ocean_process_kill(int handle);
extern buffer<i8> ocean_process_lookpath(buffer<i8> name);
extern void free(*void pointer);

struct Cmd { Path string; Args []string; Dir string; Env []string; ExitCode int; used bool; input string; hasInput bool; }

// SetStdin makes the command read text as its standard input, instead of
// inheriting this process's. The text is staged in a temporary file, so any
// amount can be supplied without blocking.
func (c *Cmd) SetStdin(text string) { c.input = text; c.hasInput = true; }
func Command(name string, args ...string) Cmd { c: Cmd; c.Path = name; c.Args = args; c.ExitCode = -1; return c; }
func clean(text string) bool {
    for (_, c := range text) { if (c == 0) return false; }
    return true;
}
func copyCString(raw buffer<i8>) string {
    bytes := []i8{};
    if ((raw -> int) != 0) { for (i := 0; raw[i] != 0; i++) bytes.append(raw[i]); }
    return bytes -> string;
}
// Process is a command started with Start. Pid is its operating-system
// process ID. After Wait (or a Poll that reports completion), ExitCode holds
// the exit status, or -1 if the process was ended by a signal, whose number is
// then in Signal (POSIX only). Copies share the native process and its result;
// each copy's ExitCode and Signal are populated by its own Wait or Poll.
struct Process { Pid int; ExitCode int; Signal int; state *processState; }

struct processState {
    mutex sync.Mutex;
    handle int;
    exitCode int;
    signal int;
    finished bool;
    waitFailed bool;
}

func (c *Cmd) execute(capture bool, combined bool, start *Process) Result<string> {
    if (c.used) return Result<string>.error("exec: command already started");
    c.used = true;
    c.ExitCode = -1;
    if (c.Path == "" || !clean(c.Path)) return Result<string>.error("exec: invalid executable");
    if (!clean(c.Dir)) return Result<string>.error("exec: directory contains NUL");
    storage := [][]i8{(c.Path + "\0") -> []i8};
    for (_, arg := range c.Args) {
        if (!clean(arg)) return Result<string>.error("exec: argument contains NUL");
        storage.append((arg + "\0") -> []i8);
    }
    argv := []int{};
    for (i := 0; i < len(storage); i++) argv.append(storage[i].data -> int);
    argv.append(0);
    envStorage := [][]i8{};
    for (_, entry := range c.Env) {
        if (!clean(entry)) return Result<string>.error("exec: environment contains NUL");
        if (len(entry) == 0 || entry[0] == '=') return Result<string>.error("exec: environment name is empty");
        equals := false;
        for (i := 1; i < len(entry); i++) { if (entry[i] == '=') equals = true; }
        if (!equals) return Result<string>.error("exec: environment entry requires NAME=value");
        envStorage.append((entry + "\0") -> []i8);
    }
    envPointers := []int{};
    for (i := 0; i < len(envStorage); i++) envPointers.append(envStorage[i].data -> int);
    envPointers.append(0);
    directory := (c.Dir + "\0") -> []i8;
    // One spare byte keeps the input buffer non-empty for the native call.
    input := (c.input + "\0") -> []i8;
    native: nativeCommand;
    native.path = storage[0].data;
    native.argv = argv.data -> (*void);
    native.directory = directory.data;
    native.environment = len(c.Env) == 0 ? zero(*void) : envPointers.data -> (*void);
    native.capture = capture ? 1 : 0;
    native.combined = combined ? 1 : 0;
    native.output = zero(buffer<i8>);
    native.error = zero(buffer<i8>);
    native.exitCode = -1;
    if (start != null) {
        handle := 0;
        pid := -1;
        code := extern.ocean_process_start(&native, input.data, len(c.input), c.hasInput ? 1 : 0, &handle, &pid);
        if (code != 0) return Result<string>.error(copyCString(native.error));
        start.state = new(processState);
        start.state.handle = handle;
        start.Pid = pid;
        start.ExitCode = -1;
        return Result<string>.value("");
    }
    code := c.hasInput ? extern.ocean_process_run_input(&native, input.data, len(c.input), 1) : extern.ocean_process_run(&native);
    c.ExitCode = native.exitCode;
    bytes := []i8{};
    if ((native.output -> int) != 0) {
        defer extern.free(native.output -> (*void));
        chunk: [4096]i8;
        for (offset := 0; offset < native.outputSize;) {
            count := native.outputSize - offset; if (count > 4096) count = 4096;
            for (i := 0; i < count; i++) chunk[i] = native.output[offset+i];
            bytes.append(chunk[:count]...); offset += count;
        }
    }
    if (code != 0) return Result<string>.error(copyCString(native.error));
    return Result<string>.value(bytes -> string);
}

// Start runs the command in the background with the parent's standard output
// and error (and its standard input unless SetStdin was used). Call Wait on
// the result to collect the exit status and release the process.
func (c *Cmd) Start() Result<Process> {
    process: Process;
    started := c.execute(false, false, &process);
    if (started.hasError()) return Result<Process>.error(started.error());
    return Result<Process>.value(process);
}

func (p *Process) collect() Result<bool> {
    state := p.state;
    if (state == null || (state -> int) == 0) return Result<bool>.error("exec: process was not started");
    state.mutex.Lock();
    defer state.mutex.Unlock();
    if (!state.finished) {
        status := extern.ocean_process_wait(state.handle, 0, &state.exitCode, &state.signal);
        if (status == 0) return Result<bool>.value(false);
        state.finished = true;
        state.waitFailed = status < 0;
        state.handle = 0;
    }
    if (state.waitFailed) return Result<bool>.error("exec: wait failed");
    p.ExitCode = state.exitCode;
    p.Signal = state.signal;
    return Result<bool>.value(true);
}

// Wait blocks until the process exits and returns its exit code, or an
// error if it failed (a nonzero exit or a signal), like Run. Waiting again
// returns the same outcome.
func (p *Process) Wait() Result<int> {
    for (;;) {
        collected := p.collect();
        if (collected.hasError()) return Result<int>.error(collected.error());
        if (collected.unwrap()) break;
        // Release the native-handle lock between polls so Kill can run.
        time.Sleep(2 * time.Millisecond);
    }
    if (p.state.signal != 0) return Result<int>.error("exec: process ended by signal " + decimal(p.state.signal));
    if (p.state.exitCode != 0) return Result<int>.error("exec: process exited unsuccessfully");
    return Result<int>.value(0);
}

// Poll reports whether the process has exited, without blocking. Once it
// returns true, ExitCode and Signal are set and Wait returns immediately.
func (p *Process) Poll() Result<bool> { return p.collect(); }

// Kill ends the process immediately (SIGKILL, or TerminateProcess on
// Windows). Call Wait afterwards to release it. Killing a process that has
// already been waited for is an error.
func (p *Process) Kill() Result<bool> {
    state := p.state;
    if (state == null || (state -> int) == 0) return Result<bool>.error("exec: process was not started");
    state.mutex.Lock();
    defer state.mutex.Unlock();
    if (state.finished) return Result<bool>.error("exec: process already finished");
    if (extern.ocean_process_kill(state.handle) != 0) return Result<bool>.error("exec: kill failed");
    return Result<bool>.value(true);
}

func decimal(n int) string {
    if (n == 0) return "0";
    digits := []i8{};
    for (n > 0) { digits.prepend(('0' + n % 10) -> i8); n = n / 10; }
    return digits -> string;
}

func (c *Cmd) Run() Result<int> {
    result := c.execute(false, false, null);
    if (result.hasError()) return Result<int>.error(result.error());
    return Result<int>.value(c.ExitCode);
}
func (c *Cmd) Output() Result<string> { return c.execute(true, false, null); }
func (c *Cmd) CombinedOutput() Result<string> { return c.execute(true, true, null); }

func LookPath(name string) Result<string> {
    if (name == "" || !clean(name)) return Result<string>.error("exec: invalid executable");
    input := (name + "\0") -> []i8;
    result := extern.ocean_process_lookpath(input.data);
    if ((result -> int) == 0) return Result<string>.error("exec: executable not found or resolves relative to current directory");
    defer extern.free(result -> (*void));
    return Result<string>.value(copyCString(result));
}

package utf8;

// UTF-8 encoding and decoding of code points held in an int.

// RuneError (U+FFFD) is returned for invalid or truncated input.
RuneError := 65533;
// MaxRune is the largest Unicode code point.
MaxRune := 1114111;
// UTFMax is the longest encoding in bytes.
UTFMax := 4;

// Decode decodes the UTF-8 sequence starting at byte offset at in text and
// returns the code point and its length in bytes. Invalid, overlong,
// surrogate or truncated sequences return (RuneError, 1); at or past the end
// it returns (RuneError, 0).
func Decode(text string, at int) (int, int) {
    if (at < 0 || at >= len(text)) return RuneError, 0;
    first := (text[at] -> u8) -> int;
    if (first < 128) return first, 1;
    width := 0;
    code := 0;
    min := 0;
    if (first >= 194 && first < 224) { width = 2; code = first & 31; min = 128; }
    else if (first >= 224 && first < 240) { width = 3; code = first & 15; min = 2048; }
    else if (first >= 240 && first < 245) { width = 4; code = first & 7; min = 65536; }
    else return RuneError, 1;
    if (at + width > len(text)) return RuneError, 1;
    for (i := 1; i < width; i++) {
        b := (text[at + i] -> u8) -> int;
        if (b < 128 || b > 191) return RuneError, 1;
        code = (code << 6) | (b & 63);
    }
    if (code < min || code > MaxRune || (code >= 55296 && code <= 57343)) return RuneError, 1;
    return code, width;
}

// DecodeLast decodes the last code point of text, returning it and its width,
// or (RuneError, 0) for empty text and (RuneError, 1) for invalid input.
func DecodeLast(text string) (int, int) {
    if (len(text) == 0) return RuneError, 0;
    start := len(text) - 1;
    for (start > 0 && start > len(text) - UTFMax && (((text[start] -> u8) -> int) & 192) == 128) start--;
    code, width := Decode(text, start);
    if (start + width != len(text)) return RuneError, 1;
    return code, width;
}

// Len returns the number of bytes needed to encode c, or -1 if c is not a
// valid code point (negative, a surrogate, or above MaxRune).
func Len(c int) int {
    if (c < 0 || c > MaxRune || (c >= 55296 && c <= 57343)) return -1;
    if (c < 128) return 1;
    if (c < 2048) return 2;
    if (c < 65536) return 3;
    return 4;
}

// Encode returns the UTF-8 encoding of c; invalid code points encode RuneError.
func Encode(c int) string {
    if (Len(c) < 0) c = RuneError;
    if (c < 128) return []i8{c -> i8} -> string;
    if (c < 2048) return []i8{(192 | (c >> 6)) -> i8, (128 | (c & 63)) -> i8} -> string;
    if (c < 65536) return []i8{(224 | (c >> 12)) -> i8, (128 | ((c >> 6) & 63)) -> i8, (128 | (c & 63)) -> i8} -> string;
    return []i8{(240 | (c >> 18)) -> i8, (128 | ((c >> 12) & 63)) -> i8, (128 | ((c >> 6) & 63)) -> i8, (128 | (c & 63)) -> i8} -> string;
}

// Valid reports whether text is entirely well-formed UTF-8.
func Valid(text string) bool {
    for (i := 0; i < len(text);) {
        code, width := Decode(text, i);
        if (code == RuneError && width == 1) return false;
        i += width;
    }
    return true;
}

// Count returns the number of code points in text; each invalid byte counts as one.
func Count(text string) int {
    count := 0;
    for (i := 0; i < len(text);) {
        _, width := Decode(text, i);
        i += width;
        count++;
    }
    return count;
}

// Runes decodes text into code points, with RuneError for invalid bytes.
func Runes(text string) []int {
    out := make([]int);
    for (i := 0; i < len(text);) {
        code, width := Decode(text, i);
        out.append(code);
        i += width;
    }
    return out;
}

// FromRunes encodes code points as a UTF-8 string.
func FromRunes(codes []int) string {
    out := make([]i8);
    for (_, c := range codes) out.append(Encode(c)...);
    return out -> string;
}
